# ---- Email / SMTP (transactional mail from Helar) -------------------------------------------------------------
# Production SMTP sender identity. All outgoing mail is sent from this address.
# NOTE: MAIL_APP_PASSWORD must be set to the mailbox password for the MAIL_FROM_EMAIL account.
#       NEVER commit the actual password to git. Set it only in your deployment environment.
MAIL_FROM_EMAIL="support@helar.law"
# SMTP app password / mailbox password for MAIL_FROM_EMAIL. Set in deploy env only.
MAIL_APP_PASSWORD=""
# Friendly From: name shown in recipient inboxes next to the sender address.
MAIL_FROM_NAME="Helar Support"
# Default reply-to so that replies to no-reply-style messages reach the support inbox.
MAIL_REPLY_TO="support@helar.law"
# SMTP host/port/TLS (Namecheap server212.web-hosting.com). Adjust only if the provider migrates servers.
MAIL_HOST="server212.web-hosting.com"
MAIL_PORT="465"
MAIL_SECURE="true"
MAIL_IMAP_PORT="993"
# Admin / ops inbox that receives internal notifications (new signups, new subscriptions, etc.)
MAIL_ADMIN_NOTIFICATION_EMAIL="support@helar.law"
# Public contact-form destination. Website messages are delivered here.
CONTACT_TO_EMAIL="info@helar.law"
